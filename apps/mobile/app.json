{
  "expo": {
    "name": "Compétences ISE",
    "slug": "competences-ise-mobile",
    "scheme": "competences-ise",
    "owner": "optimum-conseil",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F7F9FC",
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "L’application accède à vos photos uniquement pour déposer la photo de votre profil ISE.",
          "cameraPermission": "L’application utilise l’appareil photo uniquement pour prendre la photo de votre profil ISE.",
          "microphonePermission": false
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.competencesise.mobile"
    },
    "android": {
      "package": "org.competencesise.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B214A"
      }
    },
    "extra": {
      "eas": {}
    }
  }
}
