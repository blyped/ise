# ---------------------------------------------------------------------------
# Competences ISE — Mobile — variables d'environnement (Expo)
# Copier vers .env.local et renseigner. NE JAMAIS committer .env.local.
# MASTER PROMPT §76 : aucun secret dans Git, la source ou le bundle client.
#
# Seules les variables prefixees EXPO_PUBLIC_ sont incluses dans le bundle
# client par Metro — equivalent mobile du prefixe NEXT_PUBLIC_ cote web
# (voir apps/web/.env.example). Aucune cle "service_role" ne doit jamais
# apparaitre ici (D-100) : le mobile n'utilise que la cle publiable.
# ---------------------------------------------------------------------------

# --- Supabase (client, memes valeurs projet que apps/web) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Application ---
EXPO_PUBLIC_ENVIRONMENT=local
