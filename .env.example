# ---------------------------------------------------------------------------
# Competences ISE — variables d'environnement
# Copier vers .env.local et renseigner. NE JAMAIS committer .env.local.
# MASTER PROMPT §76 : aucun secret dans Git, la source, le bundle client ou le README.
# ---------------------------------------------------------------------------

# --- Supabase (client, exposees au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (serveur uniquement — JAMAIS exposee au client, D-100) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=local

# --- Recherche (serveur uniquement) ---
# Cle de scellement des curseurs de pagination (ISE-035). Le curseur renvoye
# par public.match_profiles() contient le score en base64 LISIBLE : il est
# chiffre avant d'etre remis au navigateur (MASTER PROMPT §15).
# Facultatif : a defaut, SUPABASE_SERVICE_ROLE_KEY sert de secret, et a
# defaut de celle-ci une cle aleatoire par processus (les curseurs ne
# survivent alors pas a un redemarrage — l'ecran invite a relancer).
SEARCH_CURSOR_SECRET=

# --- Email (couche d'abstraction, MASTER PROMPT §68) ---
EMAIL_PROVIDER=console
EMAIL_FROM="Competences ISE <no-reply@competences-ise.org>"
EMAIL_API_KEY=

# --- CMS / site public (serveur uniquement) ---
# ADDENDUM §46 : secret partage du point d'invalidation du cache de PUB-001
# (`POST /api/cms/revalidation-landing`, en-tete `x-ise-revalidation-secret`).
# Tant qu'il n'est pas renseigne, la route repond 503 : elle n'est jamais
# ouverte par defaut.
CMS_REVALIDATION_SECRET=
