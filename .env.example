# ---------------------------------------------------------------------------
# Competences ISE — variables d'environnement
# Copier vers .env.local et renseigner. NE JAMAIS committer .env.local.
# MASTER PROMPT §76 : aucun secret dans Git, la source, le bundle client ou le README.
# ---------------------------------------------------------------------------

# --- Supabase (client, exposees au navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (serveur uniquement — JAMAIS exposee au client, D-100) ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# --- Application ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENVIRONMENT=local

# --- Recherche (serveur uniquement) ---
# Cle de scellement des curseurs de pagination (ISE-035). Le curseur renvoye
# par public.match_profiles() contient le score en base64 LISIBLE : il est
# chiffre avant d'etre remis au navigateur (MASTER PROMPT §15).
# Facultatif : a defaut, SUPABASE_SERVICE_ROLE_KEY sert de secret, et a
# defaut de celle-ci une cle aleatoire par processus (les curseurs ne
# survivent alors pas a un redemarrage — l'ecran invite a relancer).
SEARCH_CURSOR_SECRET=

# --- Email (couche d'abstraction, MASTER PROMPT §68) ---
EMAIL_PROVIDER=console
EMAIL_FROM="Competences ISE <no-reply@competences-ise.org>"
EMAIL_API_KEY=

# --- CMS / site public (serveur uniquement) ---
# ADDENDUM §46 : secret partage du point d'invalidation du cache de PUB-001
# (`POST /api/cms/revalidation-landing`, en-tete `x-ise-revalidation-secret`).
# Tant qu'il n'est pas renseigne, la route repond 503 : elle n'est jamais
# ouverte par defaut.
CMS_REVALIDATION_SECRET=

# --- Faire un don (0134, 0135) — SERVEUR UNIQUEMENT ------------------------
# SIX variables, aucune prefixee NEXT_PUBLIC_ : le paiement se deroule sur les
# pages HEBERGEES de Stripe et de CinetPay, le navigateur n'a besoin d'aucune
# cle. Ne JAMAIS renseigner de valeur dans ce fichier : il est versionne. Les
# valeurs se posent dans Vercel (ou dans .env.local, qui n'est pas suivi par
# Git).
#
# TOUTES FACULTATIVES. Sans elles, l'application demarre normalement, le
# module de don s'annonce indisponible et l'entree de menu « Faire un don »
# n'apparait pas. Un prestataire dont il manque une variable REQUISE est
# considere indisponible : mieux vaut ne pas proposer la voie que de la voir
# echouer en plein paiement.
#
# Stripe — cartes bancaires internationales, en EUR.
#   Tableau de bord Stripe -> Developpeurs -> Cles API (cle SECRETE).
STRIPE_SECRET_KEY=
#   Tableau de bord Stripe -> Webhooks -> point de terminaison
#   https://<domaine>/api/dons/stripe -> secret de signature (`whsec_...`).
#   Evenements a souscrire : checkout.session.completed,
#   checkout.session.async_payment_succeeded,
#   checkout.session.async_payment_failed, checkout.session.expired.
STRIPE_WEBHOOK_SECRET=
#
# CinetPay v2 — mobile money et cartes en Afrique de l'Ouest, en XOF.
#   Authentification OAuth : POST {base}/v1/oauth/login { api_key, api_password }.
#   IL N'Y A PLUS DE `site_id` NI DE « Secret Key » HMAC dans la v2 : les
#   anciennes variables CINETPAY_SITE_ID et CINETPAY_SECRET_KEY sont RETIREES
#   (0135). Si elles sont encore posees dans Vercel, les supprimer.
#   REQUISES toutes les deux, sans quoi la voie CinetPay est indisponible.
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
#   FACULTATIVE. Racine de l'API CinetPay.
#     https://api.cinetpay.co  = PRODUCTION  <- valeur par defaut si absente
#     https://api.cinetpay.net = BAC A SABLE
#   Les deux ne different que par le domaine de premier niveau et les
#   intervertir ne provoque AUCUNE erreur visible : le paiement part
#   simplement dans le vide. NE RENSEIGNER que pour tester en bac a sable.
CINETPAY_BASE_URL=
#   FACULTATIVE. URL de notification serveur a serveur. A defaut, elle est
#   deduite du site : https://<domaine>/api/dons/cinetpay. A ne renseigner
#   que pour pointer une autre origine (recette, tunnel local). 120
#   caracteres au plus, limite imposee par CinetPay.
CINETPAY_NOTIFY_URL=

# --- Sentry (suivi des erreurs) ---
# DSN cote client, expose au navigateur — ce n'est pas un secret (voir
# instrumentation-client.ts, tunnelRoute masque de toute facon le domaine
# Sentry aux yeux du visiteur).
NEXT_PUBLIC_SENTRY_DSN=
# DSN cote serveur / edge (sentry.server.config.ts, sentry.edge.config.ts).
# Meme valeur que ci-dessus en pratique, mais gardee separee pour pouvoir
# utiliser un DSN different par environnement si besoin.
SENTRY_DSN=
# Slug de l'organisation et du projet Sentry (next.config.ts, upload des
# source maps a la compilation).
SENTRY_ORG=optimum-conseil
SENTRY_PROJECT=javascript-nextjs
# Jeton d'authentification pour l'upload des source maps depuis Vercel.
# A creer sur sentry.io -> Settings -> Auth Tokens (scope project:releases).
# Facultatif en developpement local ; requis en production pour que les
# traces d'erreur pointent vers le code source plutot que le bundle minifie.
SENTRY_AUTH_TOKEN=
